{
  "name": "@air-fun/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Smart contracts for air.fun",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:air:hedera": "ts-node scripts/deploy-air-hedera.ts",
    "deploy:air:base": "hardhat run scripts/deploy-air-base.ts --network base-sepolia",
    "deploy:factory:hedera": "ts-node scripts/deploy-factory-hedera.ts",
    "deploy:factory:base": "hardhat run scripts/deploy-factory-base.ts --network base-sepolia",
    "deploy:hedera": "hardhat run scripts/deploy-hedera.ts --network hedera-testnet",
    "deploy:base": "hardhat run scripts/deploy-base.ts --network base-sepolia",
    "verify": "hardhat verify"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1",
    "@hashgraph/sdk": "^2.40.0",
    "ethers": "^6.10.0"
  },
  "devDependencies": {
    "hardhat": "^2.19.5",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@typechain/hardhat": "^9.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "typechain": "^8.3.2",
    "dotenv": "^16.4.1",
    "fast-check": "^3.15.1",
    "ts-node": "^10.9.2",
    "@types/node": "^20.11.5"
  }
}
