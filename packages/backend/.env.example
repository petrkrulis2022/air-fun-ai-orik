# Blockchain - Base Sepolia
BASE_SEPOLIA_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_AIR_TOKEN_ADDRESS=
BASE_MEMECOIN_FACTORY_ADDRESS=
